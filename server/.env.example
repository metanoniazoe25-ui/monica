# Copy this file to .env and fill in what you need. Every value below is
# optional — unset ones can instead be configured from the app's Settings
# panel (Claude key, Ollama URL/model) or simply left disabled (Spotify).

PORT=8787
FRONTEND_URL=http://localhost:5173

# --- Claude (Anthropic) ---
# Leave unset to configure a key from the in-app Settings panel instead.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Hermes (local, via Ollama) ---
# Only used when you pick "Hermes (local)" as the AI brain in Settings.
# Defaults below match a stock Ollama install serving a pulled Hermes model
# (e.g. `ollama pull hermes3` then `ollama run hermes3`).
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=hermes3

# --- Spotify ---
# Create an app at https://developer.spotify.com/dashboard, add the redirect
# URI below under "Redirect URIs" in the app settings, then paste its
# Client ID/Secret here. Leave both blank to keep the Spotify panel disabled.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:8787/api/spotify/callback
